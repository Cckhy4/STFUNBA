<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>NBA Friends League</title>
<style>
:root{--bg:#08111f;--card:#12243d;--card2:#0c192b;--line:#2b4568;--text:#eef6ff;--muted:#9eb2ce;--blue:#4da8ff;--green:#35d399;--red:#ff7180;--gold:#ffd166}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% 0,#1e4676,#08111f 42%,#050a12);color:var(--text);font-family:system-ui,-apple-system,"Noto Sans TC",sans-serif}.wrap{max-width:1150px;margin:auto;padding:24px 16px 50px}.hero h1{font-size:clamp(2rem,5vw,4rem);margin:7px 0;line-height:1}.eyebrow{color:var(--blue);font-weight:800;letter-spacing:.12em;font-size:.8rem}.hero p,.muted{color:var(--muted);line-height:1.6}.layout{display:grid;grid-template-columns:1.4fr .8fr;gap:16px}.card{background:linear-gradient(145deg,#162b48ee,#0e1b2eee);border:1px solid var(--line);border-radius:20px;padding:20px;margin:16px 0;box-shadow:0 15px 48px #0004}.card h2{margin:0 0 14px;font-size:1.15rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:6px}.full{grid-column:1/-1}.field label{font-weight:700;font-size:.88rem;color:#cbdaf0}.field input,.field select{padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:#091525;color:var(--text);font:inherit}.btn{border:0;border-radius:10px;padding:11px 14px;background:var(--blue);color:#061321;font-weight:800;cursor:pointer}.btn.secondary{background:#294361;color:#eaf4ff}.btn.danger{background:#69283c;color:#ffe2e8}.btn.small{padding:7px 10px;font-size:.84rem}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.actions .btn{width:auto}.status{border:1px solid #385a83;background:#0c1c31;border-radius:12px;padding:12px;margin-top:14px}.status.open{border-color:#2b9a78}.status.closed{border-color:#a44659}.game{background:#0b1728;border:1px solid var(--line);border-radius:14px;padding:14px;margin:10px 0}.game-title{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-weight:800}.market{color:#bcd4f0;font-size:.85rem;font-weight:800;margin-top:12px}.pick{border:1px solid #3c628d;border-radius:9px;background:#122846;color:var(--text);padding:9px 10px;margin:6px 5px 0 0;cursor:pointer}.pick:hover{border-color:var(--blue);background:#18385e}.selected{border-color:var(--green)!important;background:#104038!important}.success{color:var(--green);font-weight:700}.error{color:var(--red);font-weight:700}.positive{color:var(--green)}.negative{color:var(--red)}.score{color:var(--gold);font-weight:800}.rank{color:var(--gold);font-weight:900}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{padding:9px 7px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--muted);font-size:.78rem}.player{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:#0b1728;margin:8px 0}.player.active{border-color:var(--blue)}.player-actions{display:flex;gap:5px}.result{background:#091627;border:1px dashed #41658f;border-radius:12px;padding:13px;margin-top:14px;line-height:1.75}.empty{color:var(--muted);padding:10px 0}@media(max-width:820px){.layout{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.full{grid-column:auto}}@media(max-width:450px){.wrap{padding:16px 10px 40px}.card{padding:15px}}
</style>
</head>
<body><div class="wrap">
<header class="hero"><div class="eyebrow">NBA · FRIENDS LEAGUE</div><h1>NBA Friends League</h1><p>2026–27 真實賽程 · 手動輸入賠率 · 虛擬積分排行榜</p></header>
<div class="layout"><main>
<section class="card"><h2>⏰ 遊戲時間及規則</h2><div class="grid"><div><b>初始積分</b><br><span class="score">10,000 分</span></div><div><b>每注最低</b><br><span class="score">100 分</span></div><div><b>每日最多</b><br><span class="score">2 注</span></div><div><b>每週最低</b><br><span class="score">3 注</span></div></div><div id="timeStatus" class="status"></div></section>
<section class="card"><h2>👥 玩家管理</h2><div class="grid"><div class="field"><label>玩家名稱</label><input id="newPlayer" placeholder="例如：Alex"></div><div class="field"><label>初始積分</label><input id="initial" type="number" min="0" value="10000"></div></div><div class="actions"><button class="btn" onclick="addPlayer()">新增玩家</button><button class="btn secondary" onclick="resetAll()">重設全部</button></div><p id="msg" class="muted"></p><div id="players"></div></section>
<section class="card"><h2>🏀 明日賽事</h2><div class="grid"><div class="field"><label>選擇日期</label><select id="date" onchange="renderGames()"></select></div><div class="field"><label>快速選擇</label><button class="btn secondary" onclick="chooseTomorrow()">明日賽事</button></div></div><p id="dateInfo" class="muted"></p><div id="games"></div></section>
<section class="card"><h2>🎯 提交注單</h2><p class="muted">每日 20:00 後開放輸入及提交明日賠率；24:00 後停止下注。</p><div class="grid"><div class="field full"><label>比賽</label><input id="event" readonly></div><div class="field"><label>投注選項</label><input id="selection" readonly></div><div class="field"><label>界線</label><input id="line" readonly></div><div class="field"><label>Decimal 賠率</label><input id="odds" type="number" min="1.01" step="0.01" placeholder="例如 1.91"></div><div class="field"><label>投注額（分）</label><input id="stake" type="number" min="100" step="100" value="100"></div><div class="field"><label>結果</label><select id="outcome"><option value="pending">待定</option><option value="win">勝出</option><option value="lose">落敗</option><option value="push">退回本金</option></select></div></div><div class="actions"><button class="btn" onclick="calculate()">計算回報</button><button class="btn secondary" onclick="addBet()">提交注單</button></div><div id="result" class="result">請先選擇賽事及投注選項。</div></section>
<section class="card"><h2>📋 目前玩家注單</h2><div id="history"></div></section>
</main><aside><section class="card"><h2>🏆 排行榜</h2><div id="board"></div></section><section class="card"><h2>📊 玩家狀態</h2><div id="currentStatus" class="muted"></div></section></aside></div></div>
<script>
const KEY='nba_friends_league_rules_v1';const RULES={initial:10000,minBet:100,maxDaily:2,minWeekly:3,postHour:20,lastHour:24};
const schedule=[['2026-10-20','Boston','Detroit','3:00 PM','3:00 PM'],['2026-10-20','Philadelphia','New York','7:00 PM','7:00 PM'],['2026-10-20','Oklahoma City','San Antonio','8:30 PM','9:30 PM'],['2026-10-21','Atlanta','Orlando','7:00 PM','7:00 PM'],['2026-10-21','Milwaukee','Washington','7:00 PM','7:00 PM'],['2026-10-21','Charlotte','Brooklyn','7:30 PM','7:30 PM'],['2026-10-21','Minnesota','Miami','7:30 PM','7:30 PM'],['2026-10-21','Chicago','Toronto','7:30 PM','7:30 PM'],['2026-10-21','Utah','Memphis','7:00 PM','8:00 PM'],['2026-10-21','Indiana','New Orleans','7:00 PM','8:00 PM'],['2026-10-21','Dallas','Houston','7:30 PM','8:30 PM'],['2026-10-21','Golden State','LA Lakers','7:00 PM','10:00 PM'],['2026-10-21','Phoenix','Portland','7:00 PM','10:00 PM'],['2026-10-21','Sacramento','LA Clippers','7:30 PM','10:30 PM'],['2026-10-22','Cleveland','Philadelphia','7:00 PM','7:00 PM'],['2026-10-22','Denver','Oklahoma City','8:30 PM','9:30 PM'],['2026-10-23','New York','Boston','7:00 PM','7:00 PM'],['2026-10-23','Atlanta','Charlotte','7:00 PM','7:00 PM'],['2026-10-23','Dallas','Indiana','7:00 PM','7:00 PM'],['2026-10-23','Minnesota','Orlando','7:00 PM','7:00 PM'],['2026-10-23','Toronto','Washington','7:00 PM','7:00 PM'],['2026-10-23','Detroit','Miami','8:00 PM','8:00 PM'],['2026-10-23','Chicago','Milwaukee','7:00 PM','8:00 PM'],['2026-10-23','Houston','San Antonio','8:30 PM','9:30 PM'],['2026-10-23','New Orleans','Utah','7:30 PM','9:30 PM'],['2026-10-23','Memphis','Golden State','7:00 PM','10:00 PM'],['2026-10-23','LA Clippers','LA Lakers','7:00 PM','10:00 PM'],['2026-10-23','Portland','Sacramento','7:00 PM','10:00 PM'],['2026-10-24','Miami','Charlotte','6:00 PM','6:00 PM'],['2026-10-24','Brooklyn','Cleveland','7:30 PM','7:30 PM'],['2026-10-24','Milwaukee','Philadelphia','7:30 PM','7:30 PM'],['2026-10-24','Houston','Atlanta','8:00 PM','8:00 PM'],['2026-10-24','Washington','Chicago','7:00 PM','8:00 PM'],['2026-10-24','San Antonio','Dallas','7:00 PM','8:00 PM'],['2026-10-24','New Orleans','Denver','7:00 PM','9:00 PM'],['2026-10-24','Golden State','Phoenix','7:00 PM','10:00 PM'],['2026-10-25','LA Lakers','Utah','3:00 PM','5:00 PM'],['2026-10-25','Indiana','Brooklyn','6:00 PM','6:00 PM'],['2026-10-25','Orlando','New York','7:00 PM','7:00 PM'],['2026-10-25','Toronto','Minnesota','6:00 PM','7:00 PM'],['2026-10-25','LA Clippers','Oklahoma City','6:00 PM','7:00 PM'],['2026-10-25','Detroit','Philadelphia','7:30 PM','7:30 PM'],['2026-10-25','Memphis','Sacramento','6:00 PM','9:00 PM'],['2026-10-26','Washington','Charlotte','7:00 PM','7:00 PM'],['2026-10-26','Minnesota','Cleveland','7:00 PM','7:00 PM'],['2026-10-26','Chicago','Boston','7:30 PM','7:30 PM'],['2026-10-26','Dallas','Miami','7:30 PM','7:30 PM'],['2026-10-26','Indiana','Milwaukee','7:00 PM','8:00 PM'],['2026-10-26','Phoenix','Oklahoma City','7:00 PM','8:00 PM'],['2026-10-26','Atlanta','Houston','7:30 PM','8:30 PM'],['2026-10-26','Memphis','Utah','7:00 PM','9:00 PM'],['2026-10-26','Golden State','Denver','8:00 PM','10:00 PM']];
let store=JSON.parse(localStorage.getItem(KEY)||'{"players":{},"current":""}');const $=id=>document.getElementById(id);const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function save(){localStorage.setItem(KEY,JSON.stringify(store));renderAll()}function current(){return store.players[store.current]}
function hkHour(){return Number(new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Hong_Kong',hour:'2-digit',hour12:false}).format(new Date()))}function bettingOpen(){let h=hkHour();return h>=RULES.postHour&&h<RULES.lastHour}function updateStatus(){let h=hkHour(),box=$('timeStatus');box.className='status '+(bettingOpen()?'open':'closed');box.innerHTML=bettingOpen()?`🟢 目前開放下注<br>每日 20:00 發布賠率，24:00 截止下注。香港時間目前約 ${String(h).padStart(2,'0')}:00。`:`🔴 目前未開放下注<br>賠率發布時間：每日 20:00；最後下注時間：24:00。香港時間目前約 ${String(h).padStart(2,'0')}:00。`;}
function addPlayer(){let n=$('newPlayer').value.trim(),b=Number($('initial').value);if(!n||store.players[n]){msg('請輸入未使用的玩家名稱。',true);return}store.players[n]={name:n,balance:Math.floor(b||RULES.initial),daily:0,weekly:0,bets:[]};store.current=n;$('newPlayer').value='';save();msg('玩家已新增。',false)}function msg(t,e){$('msg').textContent=t;$('msg').className=e?'error':'success'}function switchPlayer(n){store.current=n;save()}function removePlayer(n){if(confirm('確定刪除玩家「'+n+'」？')){delete store.players[n];store.current=Object.keys(store.players)[0]||'';save()}}function resetAll(){if(confirm('確定清除全部玩家、注單及排行榜？')){store={players:{},current:''};save()}}
function initDates(){let ds=[...new Set(schedule.map(x=>x[0]))];$('date').innerHTML=ds.map(d=>`<option value="${d}">${d}</option>`).join('');chooseTomorrow()}function chooseTomorrow(){let d=new Date();d.setDate(d.getDate()+1);let key=d.toISOString().slice(0,10),available=[...new Set(schedule.map(x=>x[0]))];$('date').value=available.includes(key)?key:available[0];renderGames()}function renderGames(){let d=$('date').value,games=schedule.filter(x=>x[0]===d);$('dateInfo').textContent=`${d} 共 ${games.length} 場。時間取自 PDF 的 ET 欄位；PDF 版本為 2026-08-13，賽程可能更改。`;$('games').innerHTML=games.length?games.map(g=>`<div class="game"><div class="game-title"><span>${esc(g[2])} @ ${esc(g[1])}</span><span class="muted">ET ${g[4]}</span></div><div class="market">勝出／落敗</div><button class="pick" onclick="pick('${esc(g[2])} @ ${esc(g[1])}','${esc(g[1])} 勝出','—')">${esc(g[1])} 勝出</button><button class="pick" onclick="pick('${esc(g[2])} @ ${esc(g[1])}','${esc(g[2])} 勝出','—')">${esc(g[2])} 勝出</button><div class="market">讓分</div><button class="pick" onclick="pick('${esc(g[2])} @ ${esc(g[1])}','${esc(g[1])} 讓分方','-5.5')">${esc(g[1])} 讓分 -5.5</button><button class="pick" onclick="pick('${esc(g[2])} @ ${esc(g[1])}','${esc(g[2])} 受讓方','+5.5')">${esc(g[2])} 受讓 +5.5</button><div class="market">全場總分大／細</div><button class="pick" onclick="pick('${esc(g[2])} @ ${esc(g[1])}','大分（Over）','224.5')">大分 224.5</button><button class="pick" onclick="pick('${esc(g[2])} @ ${esc(g[1])}','細分（Under）','224.5')">細分 224.5</button></div>`).join(''):'<div class="empty">該日沒有賽事。</div>'}function pick(e,s,l){$('event').value=e;$('selection').value=s;$('line').value=l;window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})}
function calc(){let p=current(),s=Number($('stake').value),o=Number($('odds').value),out=$('outcome').value;if(!p)return{error:'請先新增玩家。'};if(!bettingOpen())return{error:'目前未到 20:00 或已過 24:00，暫停下注。'};if(p.daily>=RULES.maxDaily)return{error:'今日已達最多 2 注。'};if(s<RULES.minBet)return{error:'每注最低為 100 分。'};if(!o||o<=1)return{error:'請輸入大於 1.00 的 Decimal 賠率。'};if(s>p.balance)return{error:'投注額不可高於目前積分。'};let total=out==='win'?s*o:out==='push'?s:0;return{total,profit:total-s,s,o,out}}
function calculate(){let x=calc();$('result').innerHTML=x.error?'<span class="error">'+x.error+'</span>':`總回報：<span class="positive">${x.total.toFixed(0)} 分</span><br>淨賺／輸：<span class="${x.profit>=0?'positive':'negative'}">${x.profit>0?'+':''}${x.profit.toFixed(0)} 分</span>`}function addBet(){let x=calc();if(x.error){$('result').innerHTML='<span class="error">'+x.error+'</span>';return}let p=current();p.bets.push({date:new Date().toLocaleString('zh-HK'),event:$('event').value,selection:$('selection').value,line:$('line').value,stake:x.s,odds:x.o,out:x.out,profit:x.profit});if(x.out==='win'||x.out==='lose')p.balance+=x.profit;p.daily++;p.weekly++;save();$('result').innerHTML='<span class="success">注單已提交，排行榜已更新。</span>'}
function renderPlayers(){let ns=Object.keys(store.players);$('players').innerHTML=ns.length?ns.map(n=>{let p=store.players[n];return `<div class="player ${n===store.current?'active':''}"><div><b>${esc(n)}</b><br><span class="score">${p.balance.toLocaleString()} 分</span></div><div class="player-actions"><button class="btn small" onclick="switchPlayer('${esc(n)}')">切換</button><button class="btn secondary small" onclick="removePlayer('${esc(n)}')">刪除</button></div></div>`}).join(''):'<div class="empty">尚未新增玩家。</div>'}function renderBoard(){let a=Object.values(store.players).sort((x,y)=>y.balance-x.balance);$('board').innerHTML=a.length?`<table><tr><th>#</th><th>玩家</th><th>積分</th><th>本週注數</th></tr>${a.map((p,i)=>`<tr><td class="rank">${i+1}</td><td>${esc(p.name)}</td><td>${p.balance.toLocaleString()}</td><td>${p.weekly}/${RULES.minWeekly}</td></tr>`).join('')}</table>`:'<div class="empty">尚未有排行榜資料。</div>'}function renderCurrent(){let p=current();if(!p){$('currentStatus').textContent='請先新增玩家。';$('history').innerHTML='<div class="empty">尚未有紀錄。</div>';return}$('currentStatus').innerHTML=`玩家：<b>${esc(p.name)}</b><br>積分：<span class="score">${p.balance.toLocaleString()} 分</span><br>今日下注：${p.daily}/${RULES.maxDaily}<br>本週下注：${p.weekly}/${RULES.minWeekly}`;$('history').innerHTML=p.bets.length?`<div class="table-wrap"><table><tr><th>比賽</th><th>選項</th><th>投注</th><th>賠率</th><th>結果</th><th>淨額</th></tr>${p.bets.map(b=>`<tr><td>${esc(b.event)}</td><td>${esc(b.selection)}</td><td>${b.stake}</td><td>${b.odds.toFixed(2)}</td><td>${b.out==='win'?'勝出':b.out==='lose'?'落敗':b.out==='push'?'退回':'待定'}</td><td>${b.profit}</td></tr>`).join('')}</table></div>`:'<div class="empty">目前玩家尚未有注單。</div>'}function renderAll(){updateStatus();renderPlayers();renderBoard();renderCurrent()}initDates();renderAll();setInterval(updateStatus,30000);
</script></body></html>
